# Copy to .env for local development. `.env` is gitignored and must stay that way.
# Nothing in this file is a real value. Every key here is a secret or a per-deployment
# setting; the code reads them by name from the environment and never from muster.yaml.
#
# All four are optional. The engine runs with none of them set apart from a camera.

# The RTSP stream for the zero-config single-camera quickstart. Full config for anything
# beyond the demo goes in muster.yaml (see examples/muster.yaml).
MUSTER_RTSP_URL=

# Shared secret used to HMAC-sign outbound webhook deliveries, and to authenticate the
# inbound till/POS transaction counts that make the conversion metric honest.
MUSTER_WEBHOOK_SECRET=

# Per-site cloud token. Leave empty to stay fully local — cloud sync is off by default
# and the engine is whole without it.
MUSTER_SITE_TOKEN=

# Password for the dashboard's write surface — drawing zones and lines, and anything else
# that rewrites muster.yaml. Reading the dashboard never asks for it. Referenced from
# muster.yaml by name as `api.password_env`; leave both out and every write is refused.
MUSTER_ADMIN_PASSWORD=
